QMainWindow, QDialog {
    background-color: #3e2723;
}
QWidget {
    color: #efebe9;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
}
QTabWidget::pane {
    border: 1px solid #5d4037;
}
QTabBar::tab {
    background: #4e342e;
    padding: 12px 25px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #8d6e63;
    color: #ffffff;
    font-weight: bold;
}
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox {
    padding: 8px;
    border: 1px solid #795548;
    border-radius: 4px;
    background-color: #4e342e;
    color: #efebe9;
}
QPushButton {
    padding: 8px 15px;
    border-radius: 4px;
    background-color: #795548;
    color: #ffffff;
    font-weight: bold;
    border: none;
}
QPushButton:hover {
    background-color: #8d6e63;
}
QTableView {
    background-color: #4e342e;
    gridline-color: #5d4037;
    border: none;
    selection-background-color: #5d4037;
    alternate-background-color: #462e29;
}
QHeaderView::section {
    background-color: #3e2723;
    padding: 8px;
    border: 1px solid #5d4037;
    font-weight: bold;
}
QScrollBar:vertical {
    background: #3e2723;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #795548;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #8d6e63;
}